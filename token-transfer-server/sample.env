SESSION_SECRET=secret
ENCRYPTION_SECRET=secret

# Outbound email. MAIL_PROVIDER is "cloudflare" or "sendgrid" (default).
# There is no automatic failover. Flip this to roll back to SendGrid.
MAIL_PROVIDER=sendgrid
# From address used by either provider. Falls back to SENDGRID_FROM_EMAIL.
MAIL_FROM_EMAIL=user@localhost
MAIL_FROM_NAME=Origin Protocol
# Cloudflare Email Sending. Required only when MAIL_PROVIDER=cloudflare.
# Token permission: Email Sending: Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
# SendGrid. Required only when MAIL_PROVIDER=sendgrid.
SENDGRID_FROM_EMAIL=user@localhost
SENDGRID_API_KEY=

LOCKUPS_ENABLED=true
EARLY_LOCKUPS_ENABLED_UNTIL=2020-04-15
CLIENT_URL=http://localhost:3000/#
DATABASE_URL=
UNLOCK_DATE=2019-01-01
