SESSION_SECRET=secret
ENCRYPTION_SECRET=secret

# Cloudflare Email Sending. All three of these are required.
# Token permission: Email Sending: Edit. MAIL_FROM_NAME is optional.
MAIL_FROM_EMAIL=user@localhost
MAIL_FROM_NAME=Origin Protocol
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

LOCKUPS_ENABLED=true
EARLY_LOCKUPS_ENABLED_UNTIL=2020-04-15
CLIENT_URL=http://localhost:3000/#
DATABASE_URL=
UNLOCK_DATE=2019-01-01
